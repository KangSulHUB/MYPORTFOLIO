# ==========================================
# STAGE 1: Build frontend dengan Node 22
# ==========================================
FROM node:22-bookworm-slim AS frontend

WORKDIR /app

COPY package.json package-lock.json ./

RUN npm ci --include=optional

COPY resources ./resources
COPY public ./public
COPY vite.config.js ./

RUN npm run build


# ==========================================
# STAGE 2: Laravel + FrankenPHP
# ==========================================
FROM dunglas/frankenphp:php8.5-bookworm

WORKDIR /app

# PHP extensions untuk Laravel + Neon PostgreSQL
RUN install-php-extensions \
    pdo_pgsql \
    opcache

# Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Install dependency Laravel
COPY composer.json composer.lock ./

RUN composer install \
    --no-dev \
    --no-interaction \
    --prefer-dist \
    --optimize-autoloader \
    --no-scripts

# Copy seluruh project Laravel
COPY . .

# Copy hasil build Vite dari Node 22
COPY --from=frontend /app/public/build ./public/build

# Jalankan package discovery Laravel
RUN php artisan package:discover --ansi

# Bersihkan cache Laravel
RUN php artisan optimize:clear

# Siapkan direktori Laravel
RUN mkdir -p \
    storage/framework/cache \
    storage/framework/sessions \
    storage/framework/views \
    storage/logs \
    bootstrap/cache

RUN chown -R www-data:www-data \
    storage \
    bootstrap/cache

EXPOSE 80

CMD ["frankenphp", "php-server", "--listen", "0.0.0.0:80", "--root", "public"]